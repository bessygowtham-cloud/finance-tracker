rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own document,
    // keyed by their Firebase Auth uid — matches db.collection('users').doc(uid)
    // in index.html's cloud sync code.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Trip Splitter: each trip is its own doc, deliberately public-read so a
    // friend can open a share link with no account — the link's random id is
    // the only thing gating access, same trust model Splitwise-style share
    // links use. Only a signed-in user (the app itself) can write, so a
    // visitor with just the link can view but never edit.
    match /trips/{tripId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
